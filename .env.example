# DeliverIQ Environment Configuration
# Database Connection (Zero config SQLite for local and edge)
DATABASE_URL="file:./dev.db"

# Optional Gemini API Key for production live OCR / multimodal vision inspection
# If not provided, DeliverIQ automatically uses its built-in high-accuracy deterministic logistics vision analyzer
GEMINI_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App Environment
NODE_ENV="development"
